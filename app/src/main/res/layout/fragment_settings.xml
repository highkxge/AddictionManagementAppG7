<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/Theme.AddictionManagementApp.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/Theme.AddictionManagementApp.PopupOverlay"
            app:title="Settings" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/enable_service_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable App Monitoring"
                android:textColor="#FFFFFF"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="16dp"/>

            <!-- New Total Daily Limit Slider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Daily Screen Time Limit"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/total_limit_value_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="5h 0m"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:layout_marginTop="8dp"/>

            <com.google.android.material.slider.Slider
                android:id="@+id/total_limit_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="2.0"
                android:valueTo="1440.0"
                android:stepSize="2.0"
                app:thumbColor="#4CAF50"
                app:trackColorActive="#4CAF50"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is the combined limit for all tracked apps."
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="16dp"/>

            <!-- General Per-App Limit Slider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General Per-App Limit"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/time_limit_value_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="2h 0m"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:layout_marginTop="8dp"/>

            <com.google.android.material.slider.Slider
                android:id="@+id/time_limit_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="2.0"
                android:valueTo="360.0"
                android:stepSize="2.0"
                app:thumbColor="#4CAF50"
                app:trackColorActive="#4CAF50"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Default limit applied to every app individually."
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="16dp"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/notifications_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Notifications"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/lock_apps_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enable App Locking"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/camera_analysis_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Enable Camera Distance Analysis"
                android:textColor="#FFFFFF"/>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/low_light_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:text="Enable Low Light Detection"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/reset_limits_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Reset All Custom Limits"
                android:backgroundTint="#FF5252"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/save_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Save Settings"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

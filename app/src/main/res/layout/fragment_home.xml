<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <com.yourname.addictionmanager.ui.home.ScreenTimeRingView
        android:id="@+id/screen_time_ring_view"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp" />

    <TextView
        android:id="@+id/tvTotalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/screen_time_ring_view"
        android:layout_alignBottom="@id/screen_time_ring_view"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:text="0h 0m"
        android:textAppearance="?attr/textAppearanceHeadline4" />

    <TextView
        android:id="@+id/tvUsageStatusPhrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/screen_time_ring_view"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textColor="?android:attr/textColorSecondary"
        tools:text="You are doing great!"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTopApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvUsageStatusPhrase"
        android:layout_marginTop="32dp"
        tools:listitem="@layout/item_top_app" />

</RelativeLayout>
